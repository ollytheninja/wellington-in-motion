# Copy to .env (gitignored) and fill in. Free key: https://data.linz.govt.nz/ > your profile > API keys.
LINZ_API_KEY=

# Key for the LINZ Basemaps hillshade tiles. Vite bakes it into the built site, so it is visible to
# anyone who loads the page. Get one at https://basemaps.linz.govt.nz/ and restrict it to your domain.
VITE_LINZ_BASEMAPS_KEY=
